DATABASE_URL=postgresql+asyncpg://replay:replay@db:5432/replay
ARTIFACT_DIR=/data/artifacts
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Live calls fail closed until an operator supplies a verified worst-case cost per call.
# This is a conservative reservation, not a provider billing measurement.
NEBIUS_CALL_COST_CEILING_USD=0
SECRET_KEY=change-me-in-production
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
LOG_LEVEL=INFO
RUNNER_MODE=local
# Set to true to persist investigations to ARTIFACT_DIR (survives restarts)
PERSIST_INVESTIGATIONS=false
# Antideploy uses INVESTIGATION_STORE=postgres with its provisioned DATABASE_URL.
# Leave auto for local memory/filesystem mode and Docker Compose.
INVESTIGATION_STORE=auto
