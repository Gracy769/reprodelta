FROM python:3.12-slim

# Install numpy 2.0.2 (new environment) — stdlib only, no network, no secrets.
RUN pip install --no-cache-dir numpy==2.0.2

WORKDIR /runner

COPY runner/entrypoint.py ./entrypoint.py
COPY runner/server.py ./server.py
COPY fixture/project/ /fixture/project/
ENV FIXTURE_DIR=/fixture/project EXPECTED_RUNNER_KIND=new

# Non-root user
RUN useradd -m -u 1000 runner && chown -R runner:runner /runner /fixture/project
USER runner

CMD ["python", "server.py"]
