FROM python:3.12-slim

# Install numpy 2.0.2 (new environment) — stdlib only, no network, no secrets.
RUN pip install --no-cache-dir numpy==2.0.2

WORKDIR /runner

COPY runner/entrypoint.py ./entrypoint.py

# Non-root user
RUN useradd -m -u 1000 runner && chown -R runner:runner /runner
USER runner

# No ENTRYPOINT here — compose overrides it; default reads stdin.
CMD ["python", "entrypoint.py"]
