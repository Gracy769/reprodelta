DATABASE_URL=postgresql+asyncpg://replay:replay@db:5432/replay
ARTIFACT_DIR=/data/artifacts
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/Nemotron-3_5-Lightning
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
SECRET_KEY=change-me-in-production
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
LOG_LEVEL=INFO
RUNNER_MODE=local
# Set to true to persist investigations to ARTIFACT_DIR (survives restarts)
PERSIST_INVESTIGATIONS=false
# Antideploy uses INVESTIGATION_STORE=postgres with its provisioned DATABASE_URL.
# Leave auto for local memory/filesystem mode and Docker Compose.
INVESTIGATION_STORE=auto
