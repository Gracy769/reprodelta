# Copy to deploy/oracle/.env on the VM. Never commit the filled file.
PUBLIC_DOMAIN=replace-with-your-domain.example
POSTGRES_PASSWORD=replace-with-random-hex
DATABASE_URL=postgresql+asyncpg://reprodelta:replace-with-random-hex@db:5432/reprodelta
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
PROJECT_SNAPSHOT_KEY=

# Configure matching callback URLs after the domain points to the VM.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Optional billable model calls. Zero blocks live calls.
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_CALL_COST_CEILING_USD=0

# Keep these off until the approved-project release gates pass.
E2B_API_KEY=
PROFILE_APPROVER_SUBJECTS=
E2B_PROJECT_RUNS_ENABLED=false
E2B_PROFILE_VALIDATION_ENABLED=false
E2B_SANDBOX_USD_PER_SECOND=0
E2B_PROJECT_RUN_COST_CEILING_USD=0
