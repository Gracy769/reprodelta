FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
COPY app/ ./app/
COPY runner/e2b_project.py ./runner/e2b_project.py
RUN apt-get update && apt-get install -y --no-install-recommends docker.io \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir . \
    && useradd --system --create-home projectworker \
    && chmod -R a+rX /app

USER projectworker
CMD ["python", "-m", "app.orchestrator.project_worker"]
